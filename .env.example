# Mirevox data-lineage demo / sidecar HTTP server
# Copy to .env and adjust. Used by `docker compose up`.

# Bind address inside the container (compose sets 0.0.0.0).
MIREVOX_LINEAGE_HOST=0.0.0.0

# Published host port maps to container 3847.
MIREVOX_LINEAGE_PORT=3847

# Optional absolute path to a ResidencyRule JSON array.
# When set, a missing/invalid file fails the process (fail-closed).
# When unset, the image uses /app/config/residency-rules.json (or built-in demos).
# MIREVOX_LINEAGE_RULES=/app/config/residency-rules.json

# CORS Access-Control-Allow-Origin value for the demo HTTP API.
# Default * is convenient for local demos — tighten for shared networks.
MIREVOX_LINEAGE_CORS_ORIGIN=*
